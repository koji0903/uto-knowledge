# EditorConfig helps maintain consistent coding styles for multiple developers
# working on the same project across various editors and IDEs.
# editorconfig.org

root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Line endings: Unix style (LF) for all files
[*]
end_of_line = lf

# Default indentation: 2 spaces
[*]
indent_style = space
indent_size = 2

# YAML files: 2 spaces (important for YAML syntax)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files: preserve line breaks
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true
max_line_length = 100

# JSON files: 2 spaces
[*.json]
indent_style = space
indent_size = 2

# JavaScript/TypeScript: 2 spaces
[*.{js,ts,jsx,tsx,mjs}]
indent_style = space
indent_size = 2

# Shell scripts: 2 spaces
[*.{sh,bash}]
indent_style = space
indent_size = 2

# PowerShell scripts: 2 spaces
[*.ps1]
indent_style = space
indent_size = 2
end_of_line = crlf

# Makefile: tabs required
[Makefile]
indent_style = tab

# .env files: custom rules
[.env*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
