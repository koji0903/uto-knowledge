# Windows-specific environment configuration
# Run this in PowerShell: Get-Content .env.windows | ForEach-Object { $_ -split '=' | % { $env:$_[0] = $_[1] } }

# Google Cloud / Firebase
GOOGLE_CLOUD_PROJECT=uto-os
FIRESTORE_DATABASE_ID=(default)
FIREBASE_PROJECT_ALIAS=uto-os
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_OAUTH_ACCESS_TOKEN=

# Google Drive
GOOGLE_DRIVE_ROOT_FOLDER_ID=1lj8rpJrhhUg_23zBQKbIRg0jEvugqXGF
GOOGLE_DRIVE_ROOT_FOLDER_NAME=uto-knowledge-assets
GOOGLE_DRIVE_PRODUCERS_FOLDER_ID=1rVL-YyzUc5h3DCyvUZ-UWveJQu_ki1Z7
GOOGLE_DRIVE_PRODUCTS_FOLDER_ID=1JRI_gJb7Ko5gML4KVzspgP8aALOObEwg
GOOGLE_DRIVE_PROJECTS_FOLDER_ID=1DgsDPQNP8oM8Sg1ULfPfPjv27fP_QNsf
GOOGLE_DRIVE_LOGS_FOLDER_ID=17H4YW7snnfFMNI9pK_S8TOzqku7Mo2fQ

# Obsidian
OBSIDIAN_VAULT_PATH=.
OBSIDIAN_VAULT_WINDOWS_PATH=%USERPROFILE%\workspace\uto-knowledge

# MCP Configuration
MCP_SERVER_NAME=uto-knowledge
MCP_OBSIDIAN_ENABLED=true
MCP_FIRESTORE_ENABLED=false
MCP_GOOGLE_DRIVE_ENABLED=false

# Windows-specific paths
HOME_DIR=%USERPROFILE%
TEMP_DIR=%TEMP%
SCRIPT_SHELL=powershell.exe

# Node.js / npm
NODE_ENV=development
NPM_CONFIG_LOGLEVEL=warn

# Git
GIT_AUTHOR_NAME=Claude
GIT_COMMITTER_NAME=Claude
GIT_AUTHOR_EMAIL=noreply@anthropic.com
GIT_COMMITTER_EMAIL=noreply@anthropic.com

# Windows: Enable SafeCRLF to warn about line ending issues
GIT_CONFIG_GLOBAL_SAFECRLF=warn

# PowerShell execution policy (if needed)
# Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser
