{
  "type": "object",
  "description": "Schema for product documents",
  "required": [
    "id",
    "type",
    "firestore_collection",
    "firestore_doc_id",
    "created",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^prod_[a-z0-9_]+$",
      "description": "Unique product identifier"
    },
    "type": {
      "type": "string",
      "enum": ["product"],
      "description": "Document type must be 'product'"
    },
    "firestore_collection": {
      "type": "string",
      "enum": ["products"],
      "description": "Target Firestore collection"
    },
    "firestore_doc_id": {
      "type": "string",
      "description": "Firestore document ID"
    },
    "name": {
      "type": "string",
      "description": "Product name (optional)"
    },
    "producer_id": {
      "type": "string",
      "description": "Related producer ID (optional)"
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Record creation date in YYYY-MM-DD format"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "candidate", "active", "archived"],
      "description": "Product status"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Classification tags (optional)"
    }
  },
  "additionalProperties": false
}
