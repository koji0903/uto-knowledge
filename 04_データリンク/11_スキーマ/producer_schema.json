{
  "type": "object",
  "description": "Schema for producer documents",
  "required": [
    "id",
    "type",
    "firestore_collection",
    "firestore_doc_id",
    "created",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^prodcr_[a-z0-9_]+$",
      "description": "Unique producer identifier"
    },
    "type": {
      "type": "string",
      "enum": ["producer"],
      "description": "Document type must be 'producer'"
    },
    "firestore_collection": {
      "type": "string",
      "enum": ["producers"],
      "description": "Target Firestore collection"
    },
    "firestore_doc_id": {
      "type": "string",
      "description": "Firestore document ID"
    },
    "name": {
      "type": "string",
      "description": "Producer or business name (optional)"
    },
    "category": {
      "type": "string",
      "description": "Product category (農業, 工業, 工芸, etc.) (optional)"
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Record creation date in YYYY-MM-DD format"
    },
    "status": {
      "type": "string",
      "enum": ["prospect", "candidate", "confirmed", "inactive"],
      "description": "Producer status in evaluation pipeline"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Classification tags (optional)"
    }
  },
  "additionalProperties": false
}
