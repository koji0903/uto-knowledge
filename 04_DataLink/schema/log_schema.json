{
  "type": "object",
  "description": "Schema for log documents",
  "required": [
    "id",
    "type",
    "firestore_collection",
    "firestore_doc_id",
    "created",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^log_\\d{8}_\\d{3}$",
      "description": "Log identifier in format log_YYYYMMDD_XXX"
    },
    "type": {
      "type": "string",
      "enum": ["log"],
      "description": "Document type must be 'log'"
    },
    "firestore_collection": {
      "type": "string",
      "enum": ["logs"],
      "description": "Target Firestore collection"
    },
    "firestore_doc_id": {
      "type": "string",
      "description": "Firestore document ID"
    },
    "event_type": {
      "type": "string",
      "description": "Type of event (data_update, decision, validation, etc.) (optional)"
    },
    "summary": {
      "type": "string",
      "description": "Brief event summary (optional)"
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Event date in YYYY-MM-DD format"
    },
    "status": {
      "type": "string",
      "enum": ["active", "archived"],
      "description": "Log status"
    },
    "related_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related files affected by this event (optional)"
    },
    "related_policy_cards": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related policy cards (optional)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Classification tags (optional)"
    }
  },
  "additionalProperties": false
}
