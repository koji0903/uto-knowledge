# Local environment overrides (NOT committed to Git)
# Copy to .env.local and fill in your personal secrets

# Firebase Service Account (JSON path, not the full JSON)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

# Google OAuth Token (if using interactive auth)
GOOGLE_OAUTH_ACCESS_TOKEN=REPLACE_WITH_GOOGLE_OAUTH_ACCESS_TOKEN

# API Keys (if using specific services)
ANTHROPIC_API_KEY=sk-xxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxx
GEMINI_API_KEY=xxxxxxxx

# Local overrides (optional)
# OBSIDIAN_VAULT_PATH=/custom/path/to/vault
# TEMP_DIR=/custom/temp/directory

# Development settings (optional)
DEBUG=false
VERBOSE=false
DRY_RUN=true
